# 环境配置示例
# 复制此文件为 .env 并填写实际值

# API 配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.example.com

# 使用智谱 AI 的 GLM-4.7 模型
PROVIDER=openai
MODEL=GLM-4.7

# 多模态集成测试（可选，对齐 Rust 35dc808 `_MULTIMODEL` 系列——
# 指向支持图像输入的视觉模型，与主 MODEL 互相独立）
OPENAI_API_KEY_MULTIMODEL=your_api_key_here
OPENAI_BASE_URL_MULTIMODEL=https://api.example.com
PROVIDER_MULTIMODEL=openai
MODEL_MULTIMODEL=glm-4.5v
ENABLE_MULTIMODEL_INTEGRATION_TESTS=true

# 启用集成测试
ENABLE_INTEGRATION_TESTS=true